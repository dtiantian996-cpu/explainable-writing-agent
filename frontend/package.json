{
  "name": "yasi-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:history-empty": "playwright test --config=playwright.history-empty.config.ts"
  },
  "dependencies": {
    "@tiptap/vue-3": "3.22.3",
    "axios": "1.15.0",
    "echarts": "6.0.0",
    "naive-ui": "2.44.1",
    "pinia": "3.0.4",
    "vue": "3.5.32",
    "vue-router": "5.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "24.5.2",
    "@vitejs/plugin-vue": "6.0.5",
    "@vue/test-utils": "2.4.6",
    "typescript": "6.0.2",
    "vite": "8.0.7",
    "vitest": "4.1.3",
    "vue-tsc": "3.1.1"
  }
}
